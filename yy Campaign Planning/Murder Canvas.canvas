		{"id":"fa7f0236f833eec8","x":-1159,"y":-703,"width":340,"height":293,"type":"file","file":"yy Campaign Planning/Murder in Thornfield.md"},
		{"id":"5a12d2e8388703ad","x":-610,"y":-500,"width":250,"height":60,"type":"text","text":"Who: An ambitious mage (Wants to be mayor?) Agnes? Sybil or Raz"},
		{"id":"054b172493719258","x":-167,"y":-500,"width":250,"height":60,"type":"text","text":"Why: wants to be the mayor/baron, thinks they are corrupt/incompetent"},
		{"id":"71690af232f430cd","x":171,"y":-500,"width":250,"height":60,"type":"text","text":"What: Frame the mayor for murder, fake the death of a travelling musician and plant his dagger at the scene"},
		{"id":"12f05bf5904576ab","x":-620,"y":-410,"width":250,"height":60,"color":"1","type":"text","text":"Someone hired a travelling musician"},
		{"id":"d5d58dbe585585d0","x":-322,"y":-410,"width":280,"height":60,"color":"1","type":"text","text":"- someone hired a thief to steal the mayors dagger"},
		{"id":"56658e549a9bfda0","x":-28,"y":-407,"width":278,"height":57,"color":"1","type":"text","text":"someone bought or stole a pig  from a local farmer"},
		{"id":"e5b6c9e33064ec57","x":295,"y":-419,"width":296,"height":69,"color":"1","type":"text","text":"-someone hired a child to buy components for silent image"},
